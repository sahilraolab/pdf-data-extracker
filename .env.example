# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')|console.log"
JWT_SECRET=replace_with_long_random_string_at_least_64_chars

# ── Admin account (seeded on first run if no users exist) ─────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword!
